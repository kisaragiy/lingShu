__pycache__/
*.pyc
*.pyo
/dist/
/build/
*.egg-info/
.eggs/
.venv/
venv/
.env
*.sqlite
*.sqlite-shm
*.sqlite-wal
screenshots/
memory/
*.log
eval_report.json
comic_output/
*.json
# 例外：测试夹具/数据允许入库（全局 `*.json` 是黑名单式地雷，会静默吃掉未来的 fixture）
!tests/**/*.json
# 例外：PWA manifest 是静态资源，被 `*.json` 吃掉会导致部署后 404 → SW install 整单失败、PWA 失效
!src/agent_harness/apps/research/static/manifest.json
# 公开仓库边界: 逆向/加密分析脚本与运行时数据不出仓库
reference/
src/data/
# 一次性脚本/临时文件（scratch/ 放 demo 日志、临时脚本，不该进仓库）
scratch/
tmp_*.py
fix_*.py
do_*.py
api_token.txt
jwt_secret.txt
*.key
*.spec
/site/
# 测试/CI 产物（不该进仓库，也不该在 git status 里当噪音）
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.mutmut-cache/
# harness 的机器可读载体必须入库（上面的 `*.json` 黑名单会静默吃掉它）
!PROGRESS.json
!tools/harness/*.json

# 内部设计稿/对账文档不进公开仓库（对外只展示 README 与对外架构文档）
docs/a-line-*.md
docs/*-closeout-design.md

# 内部工作准则/自查文档：只留本地，不进公开仓库
docs-internal/
